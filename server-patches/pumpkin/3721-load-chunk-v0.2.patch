+    // Adapted from Pumpkin-MC/Pumpkin PR3721, commit 5a28128648777ec5b71c23f498e66f0c6227701a.
+    async fn load_chunk(accessor: &Accessor<PluginHostState, Self>, world: Resource<World>, x: i32, z: i32)
+        -> wasmtime::Result<Resource<WitChunk>> {
+        use pumpkin_world::chunk_system::ChunkLoading;
+        let world_provider = accessor.with(|mut host| world_from_state(host.get(), &world))?;
+        let level = world_provider.level.clone();
+        let pos = pumpkin_util::math::vector2::Vector2::new(x, z);
+        {
+            let mut loading = level.chunk_loading.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+            loading.add_ticket(pos, ChunkLoading::FULL_CHUNK_LEVEL);
+            loading.send_change();
+        }
+        let chunk = level.get_or_fetch_chunk(pos, Clone::clone).await;
+        let held = level.clone();
+        level.spawn_task(async move {
+            tokio::time::sleep(std::time::Duration::from_secs(5)).await;
+            let mut loading = held.chunk_loading.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+            loading.remove_ticket(pos, ChunkLoading::FULL_CHUNK_LEVEL);
+            loading.send_change();
+        });
+        accessor.with(|mut host| host.get().add((world_provider, std::sync::Arc::downgrade(&chunk))))
+    }
